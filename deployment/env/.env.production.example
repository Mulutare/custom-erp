# Copy to deployment/env/.env.production and chmod 600. Never commit the copy.
POSTGRES_DB=passiontech_prod
POSTGRES_DB_REGEX=passiontech_prod
POSTGRES_USER=passiontech_odoo
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD
ODOO_ADMIN_PASSWD=REPLACE_WITH_STRONG_MASTER_PASSWORD
DOMAIN=erp.example.com
RELEASE_REVISION=REPLACE_WITH_APPROVED_FULL_COMMIT_SHA

# Finalize after measuring server CPU/RAM and expected concurrency.
ODOO_WORKERS=REPLACE_WITH_SIZED_INTEGER
ODOO_MAX_CRON_THREADS=REPLACE_WITH_SIZED_INTEGER
ODOO_LIMIT_MEMORY_SOFT=REPLACE_WITH_BYTES
ODOO_LIMIT_MEMORY_HARD=REPLACE_WITH_BYTES
ODOO_LIMIT_TIME_CPU=120
ODOO_LIMIT_TIME_REAL=240
ODOO_HTTP_PORT=8069
ODOO_GEVENT_PORT=8072

BACKUP_DIR=/srv/passiontech/backups
BACKUP_RETENTION_DAYS=30
MIN_FREE_DISK_GB=20
BACKUP_ENCRYPTION_RECIPIENT=OPTIONAL_EXTERNAL_KEY_REFERENCE
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_ENCRYPTION=starttls
SMTP_FROM=erp@example.com
