# Optional Nginx alternative. cPanel/WHM Apache remains the primary runbook.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
upstream passiontech_odoo { server 127.0.0.1:8069; }
upstream passiontech_gevent { server 127.0.0.1:8072; }

server {
    listen 443 ssl http2;
    server_name erp.example.com;
    client_max_body_size 128m;
    proxy_read_timeout 600s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    location /websocket {
        proxy_pass http://passiontech_gevent;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
    location / { proxy_pass http://passiontech_odoo; }
}
