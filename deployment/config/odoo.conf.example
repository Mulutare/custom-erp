[options]
admin_passwd = {{ODOO_ADMIN_PASSWD}}
db_host = db
db_port = 5432
db_user = {{POSTGRES_USER}}
db_password = {{POSTGRES_PASSWORD}}
db_name = {{POSTGRES_DB}}
dbfilter = ^{{POSTGRES_DB_REGEX}}$
list_db = False
proxy_mode = True
http_interface = 0.0.0.0
http_port = 8069
gevent_port = 8072
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/var/lib/odoo/addons/19.0,/mnt/extra-addons
data_dir = /var/lib/odoo
workers = {{ODOO_WORKERS}}
max_cron_threads = {{ODOO_MAX_CRON_THREADS}}
limit_memory_soft = {{ODOO_LIMIT_MEMORY_SOFT}}
limit_memory_hard = {{ODOO_LIMIT_MEMORY_HARD}}
limit_time_cpu = {{ODOO_LIMIT_TIME_CPU}}
limit_time_real = {{ODOO_LIMIT_TIME_REAL}}
log_level = info
log_handler = :INFO,werkzeug:WARNING
logfile = False
without_demo = True
