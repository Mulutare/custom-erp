<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="report_cash_flow" model="mis.report">
        <field name="name">PassionTech Cash Flow</field>
        <field name="description">Indirect cash flow reconciled to the period movement in cash and cash-equivalent accounts.</field>
        <field name="style_id" ref="style_statement" />
    </record>

    <record id="kpi_cash_flow_net_profit" model="mis.report.kpi">
        <field name="report_id" ref="report_cash_flow" />
        <field name="name">cash_flow_net_profit</field>
        <field name="description">Net Profit / (Loss)</field>
        <field name="sequence">10</field>
    </record>
    <record id="expr_cash_flow_net_profit" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="kpi_cash_flow_net_profit" />
        <field name="name">-balp['|', '|', '|', '|', ('account_type', '=', 'income'), ('account_type', '=', 'income_other'), ('account_type', '=', 'expense'), ('account_type', '=', 'expense_direct_cost'), ('account_type', '=', 'expense_depreciation')]</field>
    </record>

    <record id="kpi_working_capital_changes" model="mis.report.kpi">
        <field name="report_id" ref="report_cash_flow" />
        <field name="name">working_capital_changes</field>
        <field name="description">Changes in Operating Assets and Liabilities</field>
        <field name="sequence">20</field>
    </record>
    <record id="expr_working_capital_changes" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="kpi_working_capital_changes" />
        <field name="name">-balp['|', '|', '|', '|', '|', ('account_type', '=', 'asset_receivable'), ('account_type', '=', 'asset_current'), ('account_type', '=', 'asset_prepayments'), ('account_type', '=', 'liability_payable'), ('account_type', '=', 'liability_current'), ('account_type', '=', 'liability_credit_card')]</field>
    </record>

    <record id="kpi_operating_cash_flow" model="mis.report.kpi">
        <field name="report_id" ref="report_cash_flow" />
        <field name="name">operating_cash_flow</field>
        <field name="description">Net Cash from Operating Activities</field>
        <field name="auto_expand_accounts" eval="False" />
        <field name="auto_expand_accounts_style_id" eval="False" />
        <field name="style_id" ref="style_section" />
        <field name="sequence">30</field>
    </record>
    <record id="expr_operating_cash_flow" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="kpi_operating_cash_flow" />
        <field name="name">-balp['|', '|', '|', '|', '|', '|', '|', '|', '|', '|', ('account_type', '=', 'income'), ('account_type', '=', 'income_other'), ('account_type', '=', 'expense'), ('account_type', '=', 'expense_direct_cost'), ('account_type', '=', 'expense_depreciation'), ('account_type', '=', 'asset_receivable'), ('account_type', '=', 'asset_current'), ('account_type', '=', 'asset_prepayments'), ('account_type', '=', 'liability_payable'), ('account_type', '=', 'liability_current'), ('account_type', '=', 'liability_credit_card')]</field>
    </record>

    <record id="kpi_investing_cash_flow" model="mis.report.kpi">
        <field name="report_id" ref="report_cash_flow" />
        <field name="name">investing_cash_flow</field>
        <field name="description">Net Cash from Investing Activities</field>
        <field name="auto_expand_accounts" eval="False" />
        <field name="auto_expand_accounts_style_id" eval="False" />
        <field name="sequence">40</field>
    </record>
    <record id="expr_investing_cash_flow" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="kpi_investing_cash_flow" />
        <field name="name">-balp['|', ('account_type', '=', 'asset_fixed'), ('account_type', '=', 'asset_non_current')]</field>
    </record>

    <record id="kpi_financing_cash_flow" model="mis.report.kpi">
        <field name="report_id" ref="report_cash_flow" />
        <field name="name">financing_cash_flow</field>
        <field name="description">Net Cash from Financing Activities</field>
        <field name="auto_expand_accounts" eval="False" />
        <field name="auto_expand_accounts_style_id" eval="False" />
        <field name="sequence">50</field>
    </record>
    <record id="expr_financing_cash_flow" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="kpi_financing_cash_flow" />
        <field name="name">-balp['|', '|', ('account_type', '=', 'liability_non_current'), ('account_type', '=', 'equity'), ('account_type', '=', 'equity_unaffected')]</field>
    </record>

    <record id="kpi_net_cash_flow" model="mis.report.kpi">
        <field name="report_id" ref="report_cash_flow" />
        <field name="name">net_cash_flow</field>
        <field name="description">Net Increase / (Decrease) in Cash</field>
        <field name="expression">operating_cash_flow + investing_cash_flow + financing_cash_flow</field>
        <field name="style_id" ref="style_total" />
        <field name="sequence">60</field>
    </record>

    <record id="kpi_cash_account_movement" model="mis.report.kpi">
        <field name="report_id" ref="report_cash_flow" />
        <field name="name">cash_account_movement</field>
        <field name="description">Movement in Cash and Cash Equivalents</field>
        <field name="sequence">70</field>
    </record>
    <record id="expr_cash_account_movement" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="kpi_cash_account_movement" />
        <field name="name">balp[('account_type', '=', 'asset_cash')]</field>
    </record>

    <record id="kpi_cash_flow_reconciliation" model="mis.report.kpi">
        <field name="report_id" ref="report_cash_flow" />
        <field name="name">cash_flow_reconciliation</field>
        <field name="description">Cash Movement Reconciliation (must be zero)</field>
        <field name="expression">net_cash_flow - cash_account_movement</field>
        <field name="style_id" ref="style_section" />
        <field name="sequence">80</field>
    </record>

    <record id="instance_cash_flow" model="mis.report.instance">
        <field name="name">PassionTech Cash Flow</field>
        <field name="report_id" ref="report_cash_flow" />
        <field name="target_move">posted</field>
        <field name="comparison_mode" eval="True" />
    </record>
    <record id="period_cash_flow_current" model="mis.report.instance.period">
        <field name="name">Current Year</field>
        <field name="report_instance_id" ref="instance_cash_flow" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">y</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
        <field name="sequence">10</field>
    </record>
    <record id="period_cash_flow_previous" model="mis.report.instance.period">
        <field name="name">Previous Year</field>
        <field name="report_instance_id" ref="instance_cash_flow" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">y</field>
        <field name="offset">-1</field>
        <field name="duration">1</field>
        <field name="sequence">20</field>
    </record>
</odoo>
