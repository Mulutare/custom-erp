<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="style_statement" model="mis.report.style">
        <field name="name">PassionTech Financial Statement</field>
        <field name="dp_inherit" eval="False" />
        <field name="dp">2</field>
    </record>
    <record id="style_section" model="mis.report.style">
        <field name="name">PassionTech Statement Section</field>
        <field name="font_weight_inherit" eval="False" />
        <field name="font_weight">bold</field>
        <field name="background_color_inherit" eval="False" />
        <field name="background_color">#E8EEF7</field>
    </record>
    <record id="style_total" model="mis.report.style">
        <field name="name">PassionTech Statement Total</field>
        <field name="font_weight_inherit" eval="False" />
        <field name="font_weight">bold</field>
        <field name="background_color_inherit" eval="False" />
        <field name="background_color">#1F4E78</field>
        <field name="color_inherit" eval="False" />
        <field name="color">#FFFFFF</field>
    </record>
    <record id="style_detail" model="mis.report.style">
        <field name="name">PassionTech Account Detail</field>
        <field name="indent_level_inherit" eval="False" />
