<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="report_profit_and_loss" model="mis.report">
        <field name="name">PassionTech Profit &amp; Loss</field>
        <field name="description">Income and expenses classified by Odoo account type.</field>
        <field name="style_id" ref="style_statement" />
    </record>

    <record id="kpi_revenue" model="mis.report.kpi">
        <field name="report_id" ref="report_profit_and_loss" />
        <field name="name">revenue</field>
        <field name="description">Revenue</field>
        <field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" />
        <field name="sequence">10</field>
    </record>
    <record id="expr_revenue" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="kpi_revenue" />
        <field name="name">-balp[('account_type', '=', 'income')]</field>
    </record>
    <record id="kpi_cost_of_revenue" model="mis.report.kpi">
        <field name="report_id" ref="report_profit_and_loss" />
        <field name="name">cost_of_revenue</field>
        <field name="description">Cost of Revenue</field>
        <field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" />
        <field name="sequence">20</field>
    </record>
    <record id="expr_cost_of_revenue" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="kpi_cost_of_revenue" />
        <field name="name">balp[('account_type', '=', 'expense_direct_cost')]</field>
    </record>
    <record id="kpi_gross_profit" model="mis.report.kpi">
        <field name="report_id" ref="report_profit_and_loss" />
        <field name="name">gross_profit</field>
        <field name="description">Gross Profit</field>
        <field name="expression">revenue - cost_of_revenue</field>
        <field name="style_id" ref="style_section" />
        <field name="sequence">30</field>
    </record>
    <record id="kpi_operating_expenses" model="mis.report.kpi">
        <field name="report_id" ref="report_profit_and_loss" />
        <field name="name">operating_expenses</field>
        <field name="description">Operating Expenses</field>
        <field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" />
        <field name="sequence">40</field>
    </record>
    <record id="expr_operating_expenses" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="kpi_operating_expenses" />
        <field name="name">balp[('account_type', '=', 'expense')]</field>
    </record>
    <record id="kpi_depreciation" model="mis.report.kpi">
        <field name="report_id" ref="report_profit_and_loss" />
        <field name="name">depreciation</field>
        <field name="description">Depreciation</field>
        <field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" />
        <field name="sequence">50</field>
    </record>
    <record id="expr_depreciation" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="kpi_depreciation" />
        <field name="name">balp[('account_type', '=', 'expense_depreciation')]</field>
    </record>
    <record id="kpi_operating_profit" model="mis.report.kpi">
        <field name="report_id" ref="report_profit_and_loss" />
        <field name="name">operating_profit</field>
        <field name="description">Operating Profit</field>
        <field name="expression">gross_profit - operating_expenses - depreciation</field>
        <field name="style_id" ref="style_section" />
        <field name="sequence">60</field>
    </record>
    <record id="kpi_other_income" model="mis.report.kpi">
        <field name="report_id" ref="report_profit_and_loss" />
        <field name="name">other_income</field>
        <field name="description">Other Income</field>
        <field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" />
        <field name="sequence">70</field>
    </record>
    <record id="expr_other_income" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="kpi_other_income" />
        <field name="name">-balp[('account_type', '=', 'income_other')]</field>
    </record>
    <record id="kpi_net_profit" model="mis.report.kpi">
        <field name="report_id" ref="report_profit_and_loss" />
        <field name="name">net_profit</field>
        <field name="description">Net Profit / (Loss)</field>
        <field name="expression">operating_profit + other_income</field>
        <field name="style_id" ref="style_total" />
        <field name="sequence">80</field>
    </record>

    <record id="instance_profit_and_loss" model="mis.report.instance">
        <field name="name">PassionTech Profit &amp; Loss</field>
        <field name="report_id" ref="report_profit_and_loss" />
        <field name="target_move">posted</field>
        <field name="comparison_mode" eval="True" />
    </record>
    <record id="period_profit_and_loss_current" model="mis.report.instance.period">
        <field name="name">Current Year</field>
        <field name="report_instance_id" ref="instance_profit_and_loss" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">y</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
        <field name="sequence">10</field>
    </record>
    <record id="period_profit_and_loss_previous" model="mis.report.instance.period">
        <field name="name">Previous Year</field>
        <field name="report_instance_id" ref="instance_profit_and_loss" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">y</field>
        <field name="offset">-1</field>
        <field name="duration">1</field>
        <field name="sequence">20</field>
    </record>
</odoo>
