<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="report_balance_sheet" model="mis.report">
        <field name="name">PassionTech Balance Sheet</field>
        <field name="description">Assets, liabilities, and equity classified by Odoo account type.</field>
        <field name="style_id" ref="style_statement" />
    </record>

    <record id="kpi_cash" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">cash</field>
        <field name="description">Cash and Cash Equivalents</field><field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" /><field name="sequence">10</field>
    </record>
    <record id="expr_cash" model="mis.report.kpi.expression"><field name="kpi_id" ref="kpi_cash" /><field name="name">bale[('account_type', '=', 'asset_cash')]</field></record>
    <record id="kpi_receivables" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">receivables</field>
        <field name="description">Trade and Other Receivables</field><field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" /><field name="sequence">20</field>
    </record>
    <record id="expr_receivables" model="mis.report.kpi.expression"><field name="kpi_id" ref="kpi_receivables" /><field name="name">bale[('account_type', '=', 'asset_receivable')]</field></record>
    <record id="kpi_current_assets" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">current_assets</field>
        <field name="description">Other Current Assets</field><field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" /><field name="sequence">30</field>
    </record>
    <record id="expr_current_assets" model="mis.report.kpi.expression"><field name="kpi_id" ref="kpi_current_assets" /><field name="name">bale[('account_type', '=', 'asset_current')]</field></record>
    <record id="kpi_prepayments" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">prepayments</field>
        <field name="description">Prepayments</field><field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" /><field name="sequence">40</field>
    </record>
    <record id="expr_prepayments" model="mis.report.kpi.expression"><field name="kpi_id" ref="kpi_prepayments" /><field name="name">bale[('account_type', '=', 'asset_prepayments')]</field></record>
    <record id="kpi_fixed_assets" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">fixed_assets</field>
        <field name="description">Property, Plant and Equipment</field><field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" /><field name="sequence">50</field>
    </record>
    <record id="expr_fixed_assets" model="mis.report.kpi.expression"><field name="kpi_id" ref="kpi_fixed_assets" /><field name="name">bale[('account_type', '=', 'asset_fixed')]</field></record>
    <record id="kpi_noncurrent_assets" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">noncurrent_assets</field>
        <field name="description">Other Non-current Assets</field><field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" /><field name="sequence">60</field>
    </record>
    <record id="expr_noncurrent_assets" model="mis.report.kpi.expression"><field name="kpi_id" ref="kpi_noncurrent_assets" /><field name="name">bale[('account_type', '=', 'asset_non_current')]</field></record>
    <record id="kpi_total_assets" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">total_assets</field>
        <field name="description">Total Assets</field><field name="expression">cash + receivables + current_assets + prepayments + fixed_assets + noncurrent_assets</field>
        <field name="style_id" ref="style_total" /><field name="sequence">70</field>
    </record>

    <record id="kpi_payables" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">payables</field>
        <field name="description">Trade and Other Payables</field><field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" /><field name="sequence">80</field>
    </record>
    <record id="expr_payables" model="mis.report.kpi.expression"><field name="kpi_id" ref="kpi_payables" /><field name="name">-bale[('account_type', '=', 'liability_payable')]</field></record>
    <record id="kpi_current_liabilities" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">current_liabilities</field>
        <field name="description">Other Current Liabilities</field><field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" /><field name="sequence">90</field>
    </record>
    <record id="expr_current_liabilities" model="mis.report.kpi.expression"><field name="kpi_id" ref="kpi_current_liabilities" /><field name="name">-bale[('account_type', '=', 'liability_current')]</field></record>
    <record id="kpi_noncurrent_liabilities" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">noncurrent_liabilities</field>
        <field name="description">Non-current Liabilities</field><field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" /><field name="sequence">100</field>
    </record>
    <record id="expr_noncurrent_liabilities" model="mis.report.kpi.expression"><field name="kpi_id" ref="kpi_noncurrent_liabilities" /><field name="name">-bale[('account_type', '=', 'liability_non_current')]</field></record>
    <record id="kpi_credit_card" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">credit_card</field>
        <field name="description">Credit Card Liabilities</field><field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" /><field name="sequence">110</field>
    </record>
    <record id="expr_credit_card" model="mis.report.kpi.expression"><field name="kpi_id" ref="kpi_credit_card" /><field name="name">-bale[('account_type', '=', 'liability_credit_card')]</field></record>
    <record id="kpi_total_liabilities" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">total_liabilities</field>
        <field name="description">Total Liabilities</field><field name="expression">payables + current_liabilities + noncurrent_liabilities + credit_card</field>
        <field name="style_id" ref="style_section" /><field name="sequence">120</field>
    </record>

    <record id="kpi_equity" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">equity</field>
        <field name="description">Share Capital and Reserves</field><field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" /><field name="sequence">130</field>
    </record>
    <record id="expr_equity" model="mis.report.kpi.expression"><field name="kpi_id" ref="kpi_equity" /><field name="name">-bale[('account_type', '=', 'equity')]</field></record>
    <record id="kpi_retained_earnings" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">retained_earnings</field>
        <field name="description">Retained Earnings</field><field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="style_detail" /><field name="sequence">140</field>
    </record>
    <record id="expr_retained_earnings" model="mis.report.kpi.expression"><field name="kpi_id" ref="kpi_retained_earnings" /><field name="name">-bale[('account_type', '=', 'equity_unaffected')] - balu[]</field></record>
    <record id="kpi_current_earnings" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">current_earnings</field>
        <field name="description">Current Year Earnings</field><field name="sequence">150</field>
    </record>
    <record id="expr_current_earnings" model="mis.report.kpi.expression"><field name="kpi_id" ref="kpi_current_earnings" /><field name="name">-bale[('account_type', '=', 'income')] - bale[('account_type', '=', 'income_other')] - bale[('account_type', '=', 'expense')] - bale[('account_type', '=', 'expense_direct_cost')] - bale[('account_type', '=', 'expense_depreciation')]</field></record>
    <record id="kpi_total_equity" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">total_equity</field>
        <field name="description">Total Equity</field><field name="expression">equity + retained_earnings + current_earnings</field>
        <field name="style_id" ref="style_section" /><field name="sequence">160</field>
    </record>
    <record id="kpi_total_liabilities_equity" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">total_liabilities_equity</field>
        <field name="description">Total Liabilities and Equity</field><field name="expression">total_liabilities + total_equity</field>
        <field name="style_id" ref="style_total" /><field name="sequence">170</field>
    </record>
    <record id="kpi_balance_check" model="mis.report.kpi">
        <field name="report_id" ref="report_balance_sheet" /><field name="name">balance_check</field>
        <field name="description">Balance Check (must be zero)</field><field name="expression">total_assets - total_liabilities_equity</field>
        <field name="style_id" ref="style_section" /><field name="sequence">180</field>
    </record>

    <record id="instance_balance_sheet" model="mis.report.instance">
        <field name="name">PassionTech Balance Sheet</field><field name="report_id" ref="report_balance_sheet" />
        <field name="target_move">posted</field><field name="comparison_mode" eval="True" />
    </record>
    <record id="period_balance_sheet_current" model="mis.report.instance.period">
        <field name="name">Current Year End</field><field name="report_instance_id" ref="instance_balance_sheet" />
        <field name="source">actuals</field><field name="mode">relative</field><field name="type">y</field>
        <field name="offset">0</field><field name="duration">1</field><field name="sequence">10</field>
    </record>
    <record id="period_balance_sheet_previous" model="mis.report.instance.period">
        <field name="name">Previous Year End</field><field name="report_instance_id" ref="instance_balance_sheet" />
        <field name="source">actuals</field><field name="mode">relative</field><field name="type">y</field>
        <field name="offset">-1</field><field name="duration">1</field><field name="sequence">20</field>
    </record>
</odoo>
