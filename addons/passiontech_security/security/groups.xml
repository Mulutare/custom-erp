<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_passiontech" model="ir.module.category">
        <field name="name">PassionTech</field>
        <field name="description">Passion Technology controlled ERP access</field>
        <field name="sequence">1</field>
    </record>

    <record id="privilege_sales_role" model="res.groups.privilege">
        <field name="name">Sales Role</field>
        <field name="category_id" ref="module_category_passiontech"/>
        <field name="sequence">1</field>
        <field name="placeholder">No Sales Access</field>
    </record>

    <record id="privilege_inventory_role" model="res.groups.privilege">
        <field name="name">Inventory Role</field>
        <field name="category_id" ref="module_category_passiontech"/>
        <field name="sequence">2</field>
        <field name="placeholder">No Inventory Access</field>
    </record>

    <record id="privilege_finance_role" model="res.groups.privilege">
        <field name="name">Finance Role</field>
        <field name="category_id" ref="module_category_passiontech"/>
        <field name="sequence">3</field>
        <field name="placeholder">No Finance Access</field>
    </record>

    <record id="privilege_owner_role" model="res.groups.privilege">
        <field name="name">Company Governance</field>
        <field name="category_id" ref="module_category_passiontech"/>
        <field name="sequence">4</field>
        <field name="placeholder">Standard Employee</field>
    </record>

    <record id="privilege_administration" model="res.groups.privilege">
        <field name="name">Administration</field>
        <field name="category_id" ref="module_category_passiontech"/>
        <field name="sequence">5</field>
        <field name="placeholder">No Administrative Access</field>
    </record>

    <!-- Sales -->

    <record id="group_sales_officer" model="res.groups">
        <field name="name">Sales Officer</field>
        <field name="privilege_id" ref="privilege_sales_role"/>
        <field name="implied_ids"
               eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_sales_manager" model="res.groups">
        <field name="name">Sales Manager</field>
        <field name="privilege_id" ref="privilege_sales_role"/>
        <field name="implied_ids"
               eval="[
                   (4, ref('passiontech_security.group_sales_officer')),
                   (4, ref('sales_team.group_sale_manager'))
               ]"/>
    </record>

    <!-- Inventory -->

    <record id="group_inventory_officer" model="res.groups">
        <field name="name">Inventory Officer</field>
        <field name="privilege_id" ref="privilege_inventory_role"/>
        <field name="implied_ids"
               eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_inventory_manager" model="res.groups">
        <field name="name">Inventory Manager</field>
        <field name="privilege_id" ref="privilege_inventory_role"/>
        <field name="implied_ids"
               eval="[
                   (4, ref('passiontech_security.group_inventory_officer')),
                   (4, ref('stock.group_stock_manager'))
               ]"/>
    </record>

    <!-- Finance -->

    <record id="group_finance_officer" model="res.groups">
        <field name="name">Finance Officer</field>
        <field name="privilege_id" ref="privilege_finance_role"/>
        <field name="implied_ids"
               eval="[
                   (4, ref('account.group_account_invoice')),
                   (4, ref('account.group_account_user'))
               ]"/>
    </record>

    <record id="group_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="privilege_id" ref="privilege_finance_role"/>
        <field name="implied_ids"
               eval="[
                   (4, ref('passiontech_security.group_finance_officer')),
                   (4, ref('account.group_account_manager'))
               ]"/>
    </record>

    <!-- Business owner, without technical administration -->

    <record id="group_company_owner" model="res.groups">
        <field name="name">Company Owner</field>
        <field name="privilege_id" ref="privilege_owner_role"/>
        <field name="implied_ids"
               eval="[
                   (4, ref('passiontech_security.group_sales_manager')),
                   (4, ref('passiontech_security.group_inventory_manager')),
                   (4, ref('passiontech_security.group_finance_manager')),
                   (4, ref('purchase.group_purchase_manager'))
               ]"/>
    </record>

    <!-- Technical administration -->

    <record id="group_access_administrator" model="res.groups">
        <field name="name">User Access Administrator</field>
        <field name="privilege_id" ref="privilege_administration"/>
        <field name="implied_ids"
               eval="[(4, ref('base.group_erp_manager'))]"/>
    </record>

    <record id="group_system_administrator" model="res.groups">
        <field name="name">System Administrator</field>
        <field name="privilege_id" ref="privilege_administration"/>
        <field name="implied_ids"
               eval="[
                   (4, ref('passiontech_security.group_access_administrator')),
                   (4, ref('passiontech_security.group_company_owner')),
                   (4, ref('base.group_system'))
               ]"/>
    </record>

</odoo>
